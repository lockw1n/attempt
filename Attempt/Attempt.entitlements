<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TR-1.9 / FR-1.8.2: read body mass from Health. Read-only and on-device (G-5.4).
	     NOTHING iCloud IS HERE, deliberately: scripts/check-cloudkit.sh bans an iCloud
	     entitlement anywhere in the repo, because the entitlement IS the switch that turns
	     CloudKit mirroring on (OUT-0.2). -->
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
