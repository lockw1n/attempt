"settings.bodyweight.health.running" = "Reading from Health…";
"settings.bodyweight.health.result.title" = "Last import";
"settings.bodyweight.health.error.title" = "Could not import from Health";
"settings.bodyweight.health.added %lld" = "New readings added: %lld";
"settings.bodyweight.health.kept %lld" = "Days you had already logged: %lld";

