"settings.landing.load-error.message" = "Your preferences could not be read just now.";
"settings.landing.load-error.retry" = "Try again";

/* FR-1.7.2: the e1RM formula. Five of the six names are their authors' and are not translated in
   any locale; "RPE-based" is the one that describes rather than names, so it is the one that would
   be. The footnote says what changing it does, because FR-1.7.3 makes it retroactive and a lifter
   whose numbers all moved is owed a reason. */
"settings.landing.estimator.title" = "Estimated 1RM";
"settings.landing.estimator.picker" = "Formula";
"settings.landing.estimator.detail" = "Changing the formula recalculates every estimate, including past ones.";
"settings.landing.estimator.epley" = "Epley";
"settings.landing.estimator.brzycki" = "Brzycki";
"settings.landing.estimator.lombardi" = "Lombardi";
"settings.landing.estimator.oconner" = "O'Conner";
"settings.landing.estimator.wathan" = "Wathan";
"settings.landing.estimator.rpebased" = "RPE-based";

/* G-3.3: how many decimals a weight READS as. "Automatic" is the absence of a choice, not a
   value — the factory step depends on the unit (0.5 kg but 1 lb), so a stored number would become
   half-pound steps the moment the unit moved. The detail line says what this is NOT, because the
   loading increment below is the other rounding and the two are routinely confused. */
"settings.landing.precision.picker" = "Weight precision";
"settings.landing.precision.automatic" = "Automatic";
"settings.landing.precision.detail" = "How precisely weights are written on screen. It does not change what you load or what is stored.";

/* FR-1.7.1: how far back an estimate looks. */
"settings.landing.lookback.picker" = "Lookback";
"settings.landing.lookback.detail" = "Estimates come from your best qualifying set inside this window.";

/* FR-1.5.1.6: the OTHER rounding — what a bar can take, not what a number reads as. New exercises
