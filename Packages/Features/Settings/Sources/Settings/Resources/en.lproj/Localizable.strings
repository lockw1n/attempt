"settings.landing.restore.detail" = "Read a backup file back onto this device.";

"settings.restore.title" = "Restore";

"settings.restore.waiting.headline" = "No file chosen";
"settings.restore.waiting.message" = "Pick the JSON file Attempt wrote when you last backed up. Choosing a file changes nothing on its own — you will see what is in it first.";
