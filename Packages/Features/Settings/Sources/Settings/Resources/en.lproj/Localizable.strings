"settings.landing.backup.row" = "Back up everything";
"settings.landing.backup.detail" = "One file with every record on this device.";

"settings.backup.title" = "Backup";
"settings.backup.intro" = "A complete copy of everything Attempt holds on this device — your workouts, your exercises, your gyms and your settings. Nothing is sent anywhere: the file is yours to keep.";

