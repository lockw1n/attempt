"settings.restore.confirm.action" = "Replace my data";
"settings.restore.confirm.other" = "Choose a different file";

"settings.restore.dialog.title" = "Write this backup over your data?";
"settings.restore.dialog.message" = "There is no undo. Back up first if you are not sure.";
