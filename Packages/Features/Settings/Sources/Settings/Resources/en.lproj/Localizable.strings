/* Settings (G-3.4). Keys are <module>.<screen>.<element>[.<role>] — see the Localization module
   doc. Nothing here is translated: only `en` ships in Phase 1, and the point of the catalogue is
   that no screen has to be retrofitted when a second locale does. */

"settings.landing.units.title" = "Units";
"settings.landing.units.picker" = "Display unit";

/* Unit abbreviations are copy rather than ICU's, deliberately: Foundation renders UnitMass.pounds
   as "pounds" at every unit style that omits a number, and a segmented control wants "lb". A
   weight WITH a number goes through AppFormat.weight, where the symbol is ICU's. */
"settings.landing.units.kilograms" = "kg";
"settings.landing.units.pounds" = "lb";

"settings.landing.write-error.title" = "Could not save";
"settings.landing.write-error.message" = "That preference was not stored. Try setting it again.";
"settings.landing.load-error.title" = "Settings unavailable";
"settings.landing.load-error.message" = "Your preferences could not be read just now.";
"settings.landing.load-error.retry" = "Try again";

/* FR-1.7.2: the e1RM formula. Five of the six names are their authors' and are not translated in
   any locale; "RPE-based" is the one that describes rather than names, so it is the one that would
   be. The footnote says what changing it does, because FR-1.7.3 makes it retroactive and a lifter
   whose numbers all moved is owed a reason. */
"settings.landing.estimator.title" = "Estimated 1RM";
"settings.landing.estimator.picker" = "Formula";
"settings.landing.estimator.detail" = "Changing the formula recalculates every estimate, including past ones.";
"settings.landing.estimator.epley" = "Epley";
"settings.landing.estimator.brzycki" = "Brzycki";
"settings.landing.estimator.lombardi" = "Lombardi";
"settings.landing.estimator.oconner" = "O'Conner";
"settings.landing.estimator.wathan" = "Wathan";
"settings.landing.estimator.rpebased" = "RPE-based";

/* G-3.3: how many decimals a weight READS as. "Automatic" is the absence of a choice, not a
   value — the factory step depends on the unit (0.5 kg but 1 lb), so a stored number would become
   half-pound steps the moment the unit moved. The detail line says what this is NOT, because the
   loading increment below is the other rounding and the two are routinely confused. */
"settings.landing.precision.picker" = "Weight precision";
"settings.landing.precision.automatic" = "Automatic";
"settings.landing.precision.detail" = "How precisely weights are written on screen. It does not change what you load or what is stored.";

/* FR-1.7.1: how far back an estimate looks. */
"settings.landing.lookback.picker" = "Lookback";
"settings.landing.lookback.detail" = "Estimates come from your best qualifying set inside this window.";

/* FR-1.5.1.6: the OTHER rounding — what a bar can take, not what a number reads as. New exercises
   start from this step. The direction names describe the lift rather than the arithmetic: a lifter
   asks for the lighter or heavier bar, not for a floor. */
"settings.landing.rounding.title" = "Loading";
"settings.landing.rounding.increment" = "Default increment";
"settings.landing.rounding.strategy" = "Rounding";
"settings.landing.rounding.detail" = "The smallest change you can make on the bar. New exercises start here; each one can differ.";
"settings.landing.rounding.strategy.nearest" = "Nearest";
"settings.landing.rounding.strategy.down" = "Lighter";
"settings.landing.rounding.strategy.up" = "Heavier";

/* FR-1.10.2. "System" means the device's setting, which is why a fresh install stores Dark rather
   than System: G-7.1's dark is what the app adopts before a preference exists, and picking System
   is a preference. The accent is a read-out and not a picker — G-7.2 says one accent. */
"settings.landing.appearance.title" = "Appearance";
"settings.landing.appearance.theme" = "Theme";
"settings.landing.appearance.theme.system" = "System";
"settings.landing.appearance.theme.light" = "Light";
"settings.landing.appearance.theme.dark" = "Dark";
"settings.landing.appearance.accent" = "Accent";
"settings.landing.appearance.accent.value" = "Orange";
"settings.landing.appearance.accent.detail" = "One accent throughout, for actions, active state and emphasis.";

/* NFR-1.9. The control was on the training screen while the settings row had no column for it. */
"settings.landing.workout.title" = "During a workout";
"settings.landing.workout.keep-awake" = "Keep screen awake";
"settings.landing.workout.keep-awake.hint" = "The screen stays on while a workout is in progress, and sleeps normally the rest of the time.";

/* FR-1.10.3: the way into the gyms. The screen behind it is the logging module's — one screen for
   both this row and the plate calculator — so its own copy lives there and this is only the door. */
"settings.landing.equipment.title" = "Equipment";
"settings.landing.equipment.row" = "Gyms";
"settings.landing.equipment.detail" = "Bar, collars and the plates you have";

/* FR-1.8: the way into the bodyweight log. The screen behind it is this module's too, unlike the
   gyms, but the row still only names what is there. */
"settings.landing.bodyweight.title" = "Body";
"settings.landing.bodyweight.row" = "Bodyweight";
"settings.landing.bodyweight.detail" = "Weigh-ins and their seven-day average";

/* FR-1.8.1 and FR-1.8.3: the log itself. The average is over the readings there are in the seven
   days ending on a given day, not over seven days each holding one — a lifter does not weigh in
   every morning, and the copy that says what would be enough is the average.none line below
   (FR-1.13.3).

   THE CARD AND A ROW NAME TWO DIFFERENT WINDOWS AND MUST NOT SHARE A LABEL. The card is the window
   ending TODAY; a row's caption is the window ending on that row's OWN day. They disagree whenever
   the last weigh-in is old — the card refuses while every row below it still carries a figure — so
   each says which window it means: "current" above, "to this date" on the row. */
"settings.bodyweight.title" = "Bodyweight";
"settings.bodyweight.add.action" = "Add reading";
"settings.bodyweight.average.title" = "Current seven-day average";
"settings.bodyweight.average.none" = "Weigh in twice within seven days to see your current average.";
"settings.bodyweight.reading.average" = "7-day average to this date";
"settings.bodyweight.history.title" = "History";
"settings.bodyweight.empty.headline" = "No readings yet";
"settings.bodyweight.empty.message" = "Add what you weighed and the seven-day average follows from the readings.";
"settings.bodyweight.error.headline" = "Readings unavailable";
"settings.bodyweight.error.message" = "The bodyweight log could not be read.";
"settings.bodyweight.write-error.title" = "Could not save";

/* FR-1.8.2 / TR-1.9: the HealthKit import. The detail line is the consent context — G-5.4 says the
   data stays on the device, and that is worth saying beside the button rather than only in the
   system prompt. "New readings" is a labelled count and not a plural: zero is the ordinary answer
   when access was refused, which HealthKit does not disclose. */
"settings.bodyweight.health.action" = "Import from Health";
