   asks for the lighter or heavier bar, not for a floor. */
"settings.landing.rounding.title" = "Loading";
"settings.landing.rounding.increment" = "Default increment";
"settings.landing.rounding.strategy" = "Rounding";
"settings.landing.rounding.detail" = "The smallest change you can make on the bar. New exercises start here; each one can differ.";
