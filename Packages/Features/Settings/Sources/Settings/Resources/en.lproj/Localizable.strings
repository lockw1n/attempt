/* Settings (G-3.4). Keys are <module>.<screen>.<element>[.<role>] — see the Localization module
   doc. Nothing here is translated: only `en` ships in Phase 1, and the point of the catalogue is
   that no screen has to be retrofitted when a second locale does. */

"settings.landing.units.title" = "Units";
"settings.landing.units.picker" = "Display unit";

/* Unit abbreviations are copy rather than ICU's, deliberately: Foundation renders UnitMass.pounds
   as "pounds" at every unit style that omits a number, and a segmented control wants "lb". A
   weight WITH a number goes through AppFormat.weight, where the symbol is ICU's. */
"settings.landing.units.kilograms" = "kg";
"settings.landing.units.pounds" = "lb";

"settings.landing.write-error.title" = "Could not save";
"settings.landing.load-error.title" = "Settings unavailable";
"settings.landing.load-error.retry" = "Try again";

/* FR-1.7.2: the e1RM formula. Five of the six names are their authors' and are not translated in
   any locale; "RPE-based" is the one that describes rather than names, so it is the one that would
   be. The footnote says what changing it does, because FR-1.7.3 makes it retroactive and a lifter
   whose numbers all moved is owed a reason. */
"settings.landing.estimator.title" = "Estimated 1RM";
"settings.landing.estimator.picker" = "Formula";
"settings.landing.estimator.detail" = "Changing the formula recalculates every estimate, including past ones.";
"settings.landing.estimator.epley" = "Epley";
"settings.landing.estimator.brzycki" = "Brzycki";
"settings.landing.estimator.lombardi" = "Lombardi";
"settings.landing.estimator.oconner" = "O'Conner";
"settings.landing.estimator.wathan" = "Wathan";
"settings.landing.estimator.rpebased" = "RPE-based";

/* Scaffolding, deleted with the read-outs it labels when the full preferences surface lands. */
