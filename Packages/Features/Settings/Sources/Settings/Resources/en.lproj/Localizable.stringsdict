<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- FR-1.7.1's window, in days. Plural because the picker offers whatever value is in force,
	     including one carried in by a restore or a later version — a stored 1 must not read
	     "1 days". -->
	<key>settings.landing.lookback.days %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld day</string>
			<key>other</key>
			<string>%lld days</string>
		</dict>
	</dict>
	<!-- FR-1.11.1: what is in the file, said as counts. Plural because a first export is very
	     often one workout and a handful of sets, and "1 workouts" is the reading that makes a
	     lifter distrust the file. -->
	<key>settings.export.summary.workouts %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@workouts@</string>
		<key>workouts</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld workout</string>
			<key>other</key>
			<string>%lld workouts</string>
		</dict>
	</dict>
	<key>settings.export.summary.sets %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@sets@</string>
		<key>sets</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld set</string>
			<key>other</key>
			<string>%lld sets</string>
		</dict>
	</dict>
</dict>
</plist>
