<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ukrainian takes four plural categories where English takes two: one (1, 21, 31…), few
	     (2–4, 22–24…), many (0, 5–20, 25–30…) and other, which a whole number never reaches but
	     which the format still requires. Dropping any of them is what makes a count read
	     "5 день". -->
	<key>settings.landing.lookback.days %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld день</string>
			<key>few</key>
			<string>%lld дні</string>
			<key>many</key>
			<string>%lld днів</string>
			<key>other</key>
			<string>%lld дня</string>
		</dict>
	</dict>
	<key>settings.export.summary.workouts %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@workouts@</string>
		<key>workouts</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld тренування</string>
			<key>few</key>
			<string>%lld тренування</string>
			<key>many</key>
			<string>%lld тренувань</string>
			<key>other</key>
			<string>%lld тренування</string>
		</dict>
	</dict>
	<key>settings.export.summary.sets %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@sets@</string>
		<key>sets</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld підхід</string>
			<key>few</key>
			<string>%lld підходи</string>
			<key>many</key>
			<string>%lld підходів</string>
			<key>other</key>
			<string>%lld підходу</string>
		</dict>
	</dict>
	<key>settings.backup.summary.records %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@records@</string>
		<key>records</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld запис</string>
			<key>few</key>
			<string>%lld записи</string>
			<key>many</key>
			<string>%lld записів</string>
			<key>other</key>
			<string>%lld запису</string>
		</dict>
	</dict>
	<key>settings.backup.summary.workouts %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@workouts@</string>
		<key>workouts</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld тренування</string>
			<key>few</key>
			<string>%lld тренування</string>
			<key>many</key>
			<string>%lld тренувань</string>
			<key>other</key>
			<string>%lld тренування</string>
		</dict>
	</dict>
	<key>settings.backup.summary.deleted %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@deleted@</string>
		<key>deleted</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld видалений запис</string>
			<key>few</key>
			<string>%lld видалені записи</string>
			<key>many</key>
			<string>%lld видалених записів</string>
			<key>other</key>
			<string>%lld видаленого запису</string>
		</dict>
	</dict>
</dict>
</plist>
