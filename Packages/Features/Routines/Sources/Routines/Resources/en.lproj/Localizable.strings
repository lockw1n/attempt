"routines.program-editor.days.empty.message" = "Pick a routine below and it becomes this program's first day.";

"routines.program-editor.add.section" = "Add a day";
"routines.program-editor.add.empty.headline" = "No routines to add";
"routines.program-editor.add.empty.message" = "A program is made of routines. Write one first, and it will appear here.";

"routines.program-editor.day.remove" = "Remove day";
