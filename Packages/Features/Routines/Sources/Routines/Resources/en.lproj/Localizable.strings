/* Routines (G-3.4, FR-15.2, FR-17.10). Keys are <module>.<screen>.<element>[.<role>] — see the
   Localization module doc. Every key here has a Ukrainian counterpart in uk.lproj beside this file,
   and has to keep one: a key missing from that table renders its own identifier.

   ONE SCREEN AS OF T-17.12. The routine list, the routine editor, the program list and the program
   editor retired with FR-17.10.6, and their keys went with them; what survives are the keys whose
   copy Edit week draws unchanged — a target's three fields, an exercise's commands — which is why
   some spellings still say `editor` and `group`. Renaming a key costs a translation, not a rename,
   so they keep the spelling they were translated under. */

/* FR-17.10.1's screen: the current week, edited in place. */
"routines.week.title" = "Edit week";
/* What Plan your week authors before the lifter names it. Never blank: Train's root draws this as
   the heading over the week's cards. */
"routines.week.default-name" = "My week";
"routines.week.name.label" = "Week";
"routines.week.name.prompt" = "Squat block";
"routines.week.save" = "Save";
/* The one field on this screen that is held to Save, so the one refusal that names a field. */
"routines.week.name-required.message" = "Give the week a name first.";
/* Every other write here goes straight to the store, and they all fail the same way. */
"routines.week.write-error.message" = "That change could not be saved. Try again.";

"routines.week.error.headline" = "Could not load your week";
"routines.week.error.message" = "Something went wrong reading it. Try again.";

/* FR-1.13.2's first launch, reached from Plan your week. It says what a week IS, nothing else in
   the app having introduced one. */
"routines.week.empty.headline" = "No days yet";
"routines.week.empty.message" = "A week is the days you train, in order. Add one and fill in the exercises you do on it.";
"routines.week.day.add" = "Add day";

/* FR-17.10.4's day. The position is drawn on every day, named or not — an archived routine leaves
   a day whose heading is all it can say about itself. */
"routines.day.number %lld" = "Day %lld";
"routines.day.default-name %lld" = "Day %lld";
"routines.day.duplicate.name %@" = "%@ (copy)";
"routines.day.archived" = "This day's plan is gone";
"routines.day.unnamed" = "Unnamed day";

/* Behind a labelled menu rather than on swipes: a swipe is the one gesture VoiceOver and Switch
   Control cannot perform (G-4.2). The menu is named for the menu, not for any item in it. */
"routines.day.menu" = "Day actions";
"routines.day.rename" = "Rename day";
"routines.day.duplicate" = "Duplicate day";
"routines.day.up" = "Move day earlier";
"routines.day.down" = "Move day later";
"routines.day.remove" = "Remove day";

"routines.day.rename.title" = "Rename day";
"routines.day.rename.prompt" = "Heavy squat day";

/* Removing a day is soft (G-1.3) and it asks first, because the message is the part worth reading:
   the workouts already logged from this day copied their targets when they started (TR-15.3), so
   nothing on History moves. */
"routines.day.remove.title" = "Remove this day?";
"routines.day.remove.message" = "It leaves the week. The workouts you already logged on it are kept exactly as they are.";

"routines.cancel" = "Cancel";

/* The fold, announced as a VALUE: there is no expanded trait, and .isSelected means a chosen filter
   everywhere else in this app. */
"routines.day.expanded" = "Expanded";
"routines.day.collapsed" = "Collapsed";

/* The rename prompt's field can be emptied, and the week's own rule applies to it. It says what did
   NOT happen, since the day is still on screen under its old name. */
"routines.day.name-required.message" = "A day needs a name. Nothing was renamed.";

"routines.editor.exercises.empty.headline" = "No exercises yet";
"routines.editor.exercises.empty.message" = "Add the exercises this day trains, in the order you do them.";
"routines.editor.exercise.add" = "Add exercise";
"routines.editor.exercise.remove" = "Remove exercise";
/* A slot whose catalogue row could not be read. Drawn broken rather than dropped: a missing name is
   visible and a missing row is not. */
"routines.editor.exercise.unnamed" = "Unknown exercise";
"routines.editor.move.up" = "Move up";
"routines.editor.move.down" = "Move down";
"routines.exercise.menu" = "Exercise actions";

/* A group's POSITION, not a count — the top set is 1 and the backoffs follow (FR-15.2.1's
   amendment). A position takes no plural rules in either language. */
"routines.editor.group.heading %lld" = "Target %lld";
"routines.target.menu" = "Target actions";
/* FR-17.10.1's set notation: [105] kg × [4] × [4]. Copy rather than a literal, so a language that
   does not write it this way has somewhere to say so. */
"routines.target.separator" = "×";

"routines.editor.group.weight.label" = "Weight";
/* FR-15.2.2's blank target, offered in the placeholder: an empty field is a plan whose load is
   decided in the session, and this is where that is said rather than left to be guessed. */
"routines.editor.group.weight.prompt" = "Decide in session";
"routines.editor.group.reps.label" = "Reps";
"routines.editor.group.sets.label" = "Sets";
/* Drawn on a group whose weight is blank. A WORD and not a tint (G-4.5), because the alternative
   reading — a load of zero — differs from this one by an empty field alone. */
"routines.editor.group.blank" = "Weight in session";
"routines.editor.group.add" = "Add target";
"routines.editor.group.remove" = "Remove target";
"routines.editor.group.up" = "Move target up";
"routines.editor.group.down" = "Move target down";

"routines.editor.group.unit.kilograms" = "kg";
"routines.editor.group.unit.pounds" = "lb";
