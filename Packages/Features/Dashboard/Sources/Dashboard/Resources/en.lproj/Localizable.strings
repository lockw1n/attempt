/* Dashboard (G-3.4). Keys are <module>.<screen>.<element>[.<role>] — see the
   Localization module doc. */

/* FR-1.6.5's global feed, and FR-1.9.3's card over the same list. One title for both: they are the
   same feature at two lengths. */
"dashboard.recent-records.title" = "Recent PRs";
/* FR-1.13.3's insufficient-data case, not an emptied list: records are computed from logged sets,
   so what is missing is the sets rather than a fetch. Names the two things a set has to be for a
   record to come from it — completed, and a working set — because "no records yet" on its own does
   not say why a warmup-only log produced none.
   THE SECOND SENTENCE IS FR-1.6.1's REFUSAL, and this is the only screen that says it. A set that
   fell short of its target keeps the reps it reached and still sets no record — not even at those
   reps — because isCompleted is false on a set that was never performed as well as on one that
   failed, and no column separates them. It names the set rather than the lifter: "fell short of its
   target" is a fact about a row, where "you failed" is a verdict. */
"dashboard.recent-records.none" = "Complete a working set and the personal records it sets appear here. A set that fell short of its target doesn't set one, even at the reps you reached.";
"dashboard.recent-records.error" = "Recent personal records could not be read.";
/* Opens the full list behind the dashboard's card. */
"dashboard.recent-records.see-all" = "See all";
/* FR-17.2.3: one entry's label, at its two shapes — the cell the run was performed at, spelled
   "8 reps" for a single set and "5×5" for a run. "RM" is never written: it is the notation for the
   at-least-N reading D-17.2 withdrew, and a set of eight is now the 8-rep record alone. Neither
   form needs a plural rule — English reads oddly only at one rep, which is the compromise every
   count in this module already makes. */
"dashboard.recent-records.reps %lld" = "%lld reps";
"dashboard.recent-records.scheme %lld %lld" = "%1$lld×%2$lld";

/* FR-16.3.3: the set the record came from, written the way the log writes it. */
"dashboard.recent-records.set %@ %@" = "%1$@ × %2$@";
"dashboard.recent-records.run %@ %@ %@" = "%1$@ × %2$@ × %3$@";

/* FR-16.3.4: what stands where the delta would, the first time a scheme is performed. */
"dashboard.recent-records.baseline" = "First";
/* VoiceOver's hint on a feed entry. It opens the exercise, not the session — see RecentRecordRow. */
"dashboard.recent-records.exercise-hint" = "Shows this exercise's personal records.";

/* FR-1.13.2's one guided action on an install with nothing in it. It selects the Train tab (D-8),
   and it is the same words that tab's own empty state offers (FR-17.8.5) — one destination, one
   name for it. FR-1.9.4's "Start workout" was withdrawn by D-17.11. */
"dashboard.plan-week.action" = "Plan your week";

/* FR-1.9.2's card: the workout in progress, or the most recent finished one. */
"dashboard.last-workout.title" = "Last workout";
"dashboard.last-workout.none.headline" = "No workouts yet";
"dashboard.last-workout.none.message" = "Start one and it appears here, ready to repeat.";
"dashboard.last-workout.error" = "Your workouts could not be read.";
/* Said in place of a set count: a running total presented as a finished one invites the wrong
   reading. */
"dashboard.last-workout.in-progress" = "In progress";
/* Working sets — completed and not warmups (G-1.8). A label with the count after it rather than a
   counted noun phrase, on the recent-PR labels' rule: it reads correctly at every count, so no
   plural rule file is needed for a string nothing else needs one for. */
"dashboard.last-workout.sets %lld" = "Working sets: %lld";
"dashboard.last-workout.resume" = "Resume workout";
/* FR-1.9.2's repeat. Phase 1 has no prescription layer (OUT-1.1), so it copies the exercise list and
   nothing else — the label says "exercises" rather than "workout" so the empty sets are not a
   surprise. */
"dashboard.last-workout.repeat" = "Repeat these exercises";
"dashboard.last-workout.repeat-error" = "A new workout could not be started.";

/* FR-1.9.1's tiles. */
"dashboard.tiles.title" = "Estimated 1RM";
"dashboard.tiles.error" = "Your estimated maxes could not be read.";
"dashboard.tiles.none.headline" = "No lifts on the dashboard";
"dashboard.tiles.none.message" = "Choose the lifts you want an estimate for.";
/* FR-1.9.1's delta has nothing to compare against: this is the first estimate inside the window. */
"dashboard.tiles.no-previous" = "No earlier estimate to compare";
"dashboard.tiles.choose.action" = "Choose lifts";
"dashboard.tiles.choose.title" = "Dashboard lifts";
"dashboard.tiles.choose.empty" = "No exercises to choose from";
"dashboard.tiles.choose.error" = "Your exercises could not be read.";
"dashboard.tiles.choose.write-error" = "That change could not be saved.";

/* FR-1.13.3's seven reasons a tile shows no number. The wording matches the exercise library's
   equivalents key for key — the refusal is one fact carried up from E1RMCalculator, and two screens
   explaining it differently would be two accounts of it. Only the first may say "log a set"; the
   reason shown is the nearest miss among the sets inside the window, never the commonest one. */
"dashboard.tiles.no-estimates" = "Log a completed working set for one of these lifts and an estimate appears here.";

/* FR-16.5.2: the same seven reasons, in the words one line has room for. The sentences above
   are what VoiceOver reads. */
"dashboard.tiles.short.none" = "No sets yet";
"dashboard.tiles.short.stale %lld" = "Nothing in %lld days";
"dashboard.tiles.short.warmups" = "Warm-ups only";
"dashboard.tiles.short.incomplete" = "None completed";
"dashboard.tiles.short.high-reps" = "Past ten reps";
"dashboard.tiles.short.assisted" = "Assisted only";
"dashboard.tiles.short.no-effort" = "No RPE or RIR";

"dashboard.tiles.absence.none" = "Log a completed working set and an estimate appears here.";
"dashboard.tiles.absence.stale %lld" = "Nothing has been logged here in the last %lld days. An estimate reads recent training only.";
"dashboard.tiles.absence.warmups %lld" = "Only warm-up sets in the last %lld days. An estimate comes from working sets.";
"dashboard.tiles.absence.incomplete %lld" = "No completed working set in the last %lld days. A set has to be finished before it says anything about a maximum.";
"dashboard.tiles.absence.high-reps %lld" = "No estimate from the last %lld days: the best candidate went past ten reps, which is further than these formulas are accurate.";
"dashboard.tiles.absence.assisted" = "Assisted sets have no estimated max: the formulas would read more assistance as a heavier lift.";
"dashboard.tiles.absence.no-effort" = "This formula reads the RPE or RIR on a set, and the recent sets here record neither.";

/* FR-1.13.2. Shown INSTEAD OF every section on an install with nothing logged — one guided state
   rather than five apologies pointing at the same action, which is why it carries the action
   itself. It is also the only shape of this screen that spends an accent, D-17.11 having withdrawn
   the button that used to sit above the sections. The headline is about the app filling up rather
   than about emptiness: "No data" is true and says nothing worth reading. */
"dashboard.first-launch.headline" = "Your training log starts here";
/* Names the four things the screen becomes, in the order it draws them, so the reward is concrete
   rather than a promise. */
"dashboard.first-launch.message" = "Log your first workout and this screen fills in: what you last trained, your week's volume, your personal records and your estimated maxes.";

/* FR-1.9.5's this-week summary. "This week" is the user's own week — Calendar.current decides which
   day it starts on, so a locale beginning on Monday gets one. */
"dashboard.week.title" = "This week";
/* MetricTile labels: what each numeral is. Nouns rather than counted phrases, so neither needs a
   plural rule — the number sits above the label, not inside it. */
"dashboard.week.workouts" = "Workouts";
"dashboard.week.volume" = "Volume";
/* FR-1.13.3 rather than a pair of zeros: a quiet week has nothing to report, and "0 kg" invites the
   reading that the training was worthless rather than absent. */
"dashboard.week.none" = "No working sets logged this week yet.";
/* Tonnage's third clause, said out loud on the one screen that can. The week has real workouts and a
   volume that cannot be computed — every set in it was bodyweight or assisted, and an assisted set's
   load is negative, so summing it would make the total fall as more work was done. */
"dashboard.week.unweighed" = "Nothing this week carries a load to weigh — bodyweight and assisted sets add no volume.";
"dashboard.week.error" = "This week's training could not be read.";

/* FR-16.3.4's empty feed under a narrowed configuration. It is not "no records yet": the records
   exist and the settings are what hide them, so the sentence names the settings rather than one of
   them — the scope, the first-time flag and a chosen scheme list can each empty the feed alone, and
   a sentence naming only the lifts would be wrong for the other two. The button offers the widest
   of all three, a control rather than a sentence pointing at Settings. */
"dashboard.recent-records.none-in-scope" = "No recent personal records match your Recent PRs settings.";
"dashboard.recent-records.show-every" = "Show everything";

/* FR-16.3's configuration screen, reached from Settings. The title matches the feed's own: it is
   the same feature, and a second name would read as a second one. */
"dashboard.recent-records.settings.title" = "Recent PRs";
"dashboard.recent-records.settings.error" = "Your Recent PRs settings could not be read.";
"dashboard.recent-records.settings.write-error" = "That change could not be saved.";

/* FR-16.3.1's scope. The detail names where the first option's list comes from, because that is the
   whole point of it: one selection, obeyed by the dashboard tiles and by this feed. */
"dashboard.recent-records.scope.title" = "Which lifts";
"dashboard.recent-records.scope.dashboard-lifts" = "Dashboard";
"dashboard.recent-records.scope.every-exercise" = "Everything";
"dashboard.recent-records.scope.chosen" = "Chosen";
"dashboard.recent-records.scope.detail" = "Dashboard follows the lifts you tile an estimated 1RM for, so one choice covers both.";
"dashboard.recent-records.exercises.title" = "Lifts in this feed";
"dashboard.recent-records.exercises.empty" = "No exercises to choose from";

/* FR-16.3.2. "Derived" is stated as the threshold rather than as a word, since three is the whole
   rule and a lifter cannot guess it. The list under the toggle offers the schemes their own records
   are held at — the full table is sixty cells, which is not a control. */
"dashboard.recent-records.schemes.title" = "Which schemes";
"dashboard.recent-records.schemes.derived" = "Follow my training";
"dashboard.recent-records.schemes.detail" = "Shows records at any rep-and-set scheme you have trained at least three times. Turn it off to pick the schemes yourself.";
"dashboard.recent-records.schemes.empty" = "No records to choose a scheme from yet.";

/* FR-16.3.4. The label says what a baseline is rather than naming it: "baseline" is our word for it,
   and the lifter's is "the first time". */
"dashboard.recent-records.baselines.title" = "First-time records";
"dashboard.recent-records.baselines.label" = "Show first-time records";
"dashboard.recent-records.baselines.detail" = "The first time you perform a scheme it sets a record with nothing to compare against. Off by default, so a new accessory lift does not fill the feed.";
"dashboard.tiles.training-max %@" = "Training max %@";

/* FR-16.4.3. A workout dated ahead of today: nothing has been logged against it and nothing is
   being logged now, so neither "In progress" nor a set count of zero is true of it. */
"dashboard.last-workout.planned" = "Planned";

/* FR-16.5.3: the two exercise pickers — the dashboard's tiled lifts and the recent-PR feed's chosen
   scope — are one list, so their copy is one set of keys. "Exercise picker" is not a screen name:
   it is the list both screens draw, which is what the middle segment names here. */
"dashboard.exercise-picker.search.prompt" = "Search exercises";

/* The trained section is first and is what the requirement is for: a lifter choosing lifts should
   start from the ones they actually train. "Everything else" rather than "All": the section is the
   remainder, and a heading saying "All" over a list the trained rows have been taken out of would
   be false. */
"dashboard.exercise-picker.section.trained" = "Trained";
"dashboard.exercise-picker.section.everything-else" = "Everything else";

/* Under a trained row's name. The date arrives rendered, so the sentence carries no format of its
   own and cannot disagree with the one the screen is using. */
"dashboard.exercise-picker.row.last-trained %@" = "Last trained %@";

/* A search that matched nothing. The search field stays on screen above this, so the message names
   the query as the cause rather than the catalogue — and the action is the same clearing the field
   would do, offered again where the reader is looking. */
"dashboard.exercise-picker.no-matches.headline" = "No exercises match";
"dashboard.exercise-picker.no-matches.message" = "Try a different search, or clear it to see every exercise.";
"dashboard.exercise-picker.no-matches.action" = "Clear search";
