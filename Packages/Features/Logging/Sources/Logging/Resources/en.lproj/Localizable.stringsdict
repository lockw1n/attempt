<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- FR-1.2.13's session progress. Positional, so a translation can reorder the two numbers,
	     and plural on the second, because that is the one the noun agrees with: a workout with
	     one exercise in it reads "1 of 1 exercise complete". A .strings entry cannot express
	     that, which is why this file exists — the first of its kind in the app. -->
	<key>logging.session.progress %lld %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld of %2$#@exercises@ complete</string>
		<key>exercises</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld exercise</string>
			<key>other</key>
			<string>%lld exercises</string>
		</dict>
	</dict>
	<!-- FR-1.4.2's plate list. Plural on the pair count: a gym with one pair of 20s reads
	     "20 kg × 1 pair", and a .strings entry can only ever say "1 pairs". The plate itself is
	     already rendered — AppFormat decides how a weight reads, and a catalogue cannot. -->
	<key>logging.equipment.plate-pairs %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ × %2$#@pairs@</string>
		<key>pairs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld pair</string>
			<key>other</key>
			<string>%lld pairs</string>
		</dict>
	</dict>
	<!-- FR-15.3.1's target beside a set. Plural on the rep count, which is the noun's number:
	     a single at the top of a plan reads "Target 100 kg × 1 rep". The load is already
	     rendered — AppFormat decides how a weight reads, and a catalogue cannot. -->
	<key>logging.session.plan.target %@ %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Target %1$@ × %2$#@reps@</string>
		<key>reps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld rep</string>
			<key>other</key>
			<string>%lld reps</string>
		</dict>
	</dict>
	<!-- FR-15.2.2's blank target: the reps are prescribed and the load is not, which is a third
	     state rather than a missing weight. -->
	<key>logging.session.plan.target-open %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Target %#@reps@, load your own</string>
		<key>reps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld rep</string>
			<key>other</key>
			<string>%lld reps</string>
		</dict>
	</dict>
	<!-- FR-15.3.2's deviation, unsigned — the indicator beside it carries the direction. One is
	     the commonest miss there is, so "1 reps" would be the string's usual reading. -->
	<key>logging.session.plan.reps-delta %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@reps@</string>
		<key>reps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld rep</string>
			<key>other</key>
			<string>%lld reps</string>
		</dict>
	</dict>
	<!-- FR-15.3.3's adherence. Positional and plural on the second for the session progress
	     line's reason: the noun agrees with the total, so a routine prescribing one set reads
	     "1 of 1 set". The pair is the requirement's own wording — sets completed as prescribed
	     over total prescribed — and no percentage is drawn beside it, since 5 of 9 is the fact
	     and "56%" is the same fact restated to a precision nine sets do not carry. -->
	<key>logging.session.adherence %lld %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld of %2$#@sets@</string>
		<key>sets</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld set</string>
			<key>other</key>
			<string>%lld sets</string>
		</dict>
	</dict>
</dict>
</plist>
