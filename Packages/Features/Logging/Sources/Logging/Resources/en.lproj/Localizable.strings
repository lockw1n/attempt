/* Logging (G-3.4). Keys are <module>.<screen>.<element>[.<role>] — see the Localization module doc.
   The two screens are the Train root, where a workout is started or resumed, and the workout
   itself. Every key here has a Ukrainian counterpart in uk.lproj beside this file, and has to
   keep one: a key missing from that table renders its own identifier. */

/* Nothing is in progress. FR-1.13.2's first-launch guidance: the headline says what there is none
   of and the message names both ways to make one, since backdating is the half a new user would not
   guess. */
"logging.train.empty.headline" = "No workout in progress";
"logging.train.empty.message" = "Start today's workout, or pick an earlier date to log one you have already done.";
"logging.train.start.action" = "Start workout";

"logging.train.date.section" = "Workout date";
"logging.train.date.picker" = "Training day";
/* Says what the date is for rather than how to use the control: FR-1.2.1's backdating is about
   which day the workout counts as, not when it was typed in. */
"logging.train.date.hint" = "Today, unless you are logging a workout from an earlier day.";

"logging.train.in-progress.section" = "In progress";
"logging.train.in-progress.day" = "Training day";
"logging.train.in-progress.started" = "Started";
/* FR-1.2.11: the way back into a workout the app came back to. "Resume" rather than "Open", because
   the workout was interrupted — by a relaunch, a force-quit or a walk to the rack. */
"logging.train.in-progress.resume" = "Resume workout";

"logging.train.library.action" = "Browse exercises";
/* FR-15.2.1, beside the library. "Routines" rather than "Plans": a routine is one training day,
   and a plan reads like the week. */
"logging.train.routines.action" = "Routines";

/* The read failed — the screen does not know whether a workout is in progress, so this one takes
   the whole screen. A sentence for the user; the diagnostic is never shown. */
"logging.train.error.headline" = "Workouts unavailable";
"logging.train.error.message" = "Your workouts could not be read just now.";

/* The start failed, which is a *write* and not a phase: it renders beside the command that issued
   it, with the date control still on screen, so the retry is another tap at the same button rather
   than a workout the user has to ask for again. Never the read's copy — nothing was unreadable. */
"logging.train.start-error.message" = "That workout could not be started. Try again.";

"logging.session.title" = "Workout";
"logging.session.summary.section" = "This workout";
"logging.session.day" = "Training day";
"logging.session.started" = "Started";
"logging.session.adherence" = "Adherence";

/* The workout exists and has nothing in it. The action is FR-1.2.2's chooser, which is also the
   only command this state can offer — the sets inside an exercise need an exercise first. */
"logging.session.empty.headline" = "No exercises yet";
"logging.session.empty.message" = "Exercises you add to this workout appear here.";

"logging.session.finish.action" = "Finish workout";
"logging.session.discard.action" = "Discard workout";

/* FR-1.2.12's explicit confirmation. The message names what is lost, and the confirming button says
   what it does rather than "OK" — the two places a destructive dialogue is usually vague. */
"logging.session.discard.confirm.title" = "Discard this workout?";
"logging.session.discard.confirm.message" = "Everything logged in it is removed from your history.";
"logging.session.discard.confirm.action" = "Discard";
/* PRESENTATION-DEPENDENT, AND KEPT ON PURPOSE. iOS 26 renders this dialogue as a popover, and a
   popover suppresses the `.cancel` button — only Discard is drawn, and dismissing is a tap outside.
   The button stays: the suppression is that presentation's and not universal, and the `.cancel`
   role is what binds keyboard dismissal and gives VoiceOver an explicit way out that tap-outside
   does not (G-4.2, NFR-1.10). A string nothing currently draws still resolves, so no test can tell
   you this — which is why it is written down here. */
"logging.session.discard.confirm.cancel" = "Keep workout";

/* The read failed, on the screen the workout itself is on. Split from the copy below because the
   two are different facts: one says the workout is gone, and this one says we could not tell. It
   carries a retry; the one below cannot. */
"logging.session.error.headline" = "Workout unavailable";
"logging.session.error.message" = "This workout could not be read just now.";

/* The screen is open on a workout that is no longer in progress — a restored navigation stack after
   the workout was finished or discarded. Not an error the user caused, and there is nothing to
   retry. */
"logging.session.ended.headline" = "No workout in progress";
"logging.session.ended.message" = "This workout has been finished or discarded.";

/* A write that did not land. The workout stays on screen beside it, so the retry is another tap. */
"logging.session.write-error.message" = "That could not be saved. Nothing has been lost — try again.";

/* FR-1.2.9: the workout's own note, which is prose about the session rather than about one set —
   the per-set note is logging.session.set.notes.* further down. */
"logging.session.notes.section" = "Session notes";
"logging.session.notes.prompt" = "How did the session go?";
"logging.session.notes.save" = "Save note";
"logging.session.notes.discard" = "Discard changes";
/* The note did not store. The typed text stays on screen beside this, so the retry is another tap
   at Save rather than a note the user has to write again. */
"logging.session.notes.error" = "That note could not be saved. Nothing has been lost — try again.";

/* FR-1.2.10: what this exercise looked like the last time it was trained, drawn inside the card so
   that seeing it needs no navigation. The date is rendered beside this heading through AppFormat. */
"logging.session.previous.heading" = "Last time";
/* One set on that strip: a load and a repetition count, both already rendered by AppFormat. The
   multiplication sign is a character of this language, and the order of the two is not fixed in
   every language — which is why this is a format string and not an interpolation. */
"logging.session.previous.set %@ %@" = "%1$@ × %2$@";
/* FR-16.1.1: the same line for a run of identical sets, which is what four back-off sets look like
   when they are read rather than counted. A third argument rather than a repetition of the line
   above — the second multiplication sign is punctuation of this language too. */
"logging.session.previous.group %@ %@ %@" = "%1$@ × %2$@ × %3$@";
/* FR-1.13.3, not FR-1.13.1's empty: there is history here and none of it is about this exercise, so
   the message says what would make a comparison possible rather than what to create. */
"logging.session.previous.empty.headline" = "No previous session";
"logging.session.previous.empty.message" = "Log it today and it will be here next time.";
/* The history could not be read. Shown once beneath the cards rather than inside each of them: one
   read answers every strip in the workout. */
"logging.session.previous.error.message" = "Your previous sessions could not be read just now.";

/* FR-1.2.2 and FR-1.2.13: the workout's exercises, as a vertical list of cards. */
"logging.session.exercises.section" = "Exercises";
"logging.session.add-exercise.action" = "Add exercise";
/* Said in words as well as by the folded card, colour and shape never being the only cue (G-4.5). */
"logging.session.exercise.completed" = "Completed";
/* A label beside a number, so it stays a count in every language rather than needing a plural. */
"logging.session.exercise.sets" = "Sets";
/* An entry naming a catalogue row that is not there — a restore or a sync that arrived incomplete.
   The card is rendered broken rather than dropped: an exercise silently missing from a workout is
   worse than one the user can see is wrong. */
"logging.session.exercise.missing" = "Exercise unavailable";
/* VoiceOver's value for the control that folds a card. The chevron that shows it is decorative and
   hidden, so without these the fold is invisible to VoiceOver (G-4.2). */
"logging.session.exercise.expanded" = "Expanded";
"logging.session.exercise.collapsed" = "Collapsed";
/* Accessibility labels: both controls draw a glyph and have no visible title (G-4.2). */
"logging.session.exercise.move-up" = "Move up";
"logging.session.exercise.move-down" = "Move down";

/* The exercises could not be read. Separate from the session's own read failure because they are
   separate reads: the workout can be on screen while its contents are not. */
"logging.session.exercises.error.headline" = "Exercises unavailable";
"logging.session.exercises.error.message" = "The exercises in this workout could not be read just now.";
/* A failed write — adding or reordering. The cards stay beside it, so the retry is another tap. */
"logging.session.exercises.write-error.message" = "That could not be saved. Nothing has been lost — try again.";

/* FR-1.2.13's session progress is in Localizable.stringsdict beside this file, not here: the noun
   agrees with the total, so "1 of 1 exercise complete" needs a plural rule rather than a format. */

/* FR-1.2.3, FR-1.2.5, FR-1.2.6: the sets logged inside one exercise card, and the editor that
   fills one in. The editor is presented rather than pushed — NFR-1.4 wants every logging control
   in the lower two-thirds, and a card can be anywhere the user scrolled it to. */
"logging.session.set.empty" = "No sets logged yet.";
"logging.session.set.add.action" = "Add set";
/* FR-1.2.6, and the action the whole screen is shaped around: it opens the editor already filled
   in from the last set, so repeat-adjust-confirm is three taps (NFR-1.3). */
"logging.session.set.repeat.action" = "Repeat set";
"logging.session.set.editor.title" = "Log set";
"logging.session.set.weight.label" = "Weight";
"logging.session.set.reps.label" = "Reps";
"logging.session.set.rpe.label" = "RPE";
/* The range is the form's, not the record's: a stored row is never validated, because a set
   arriving from a newer version has to survive being read. A keystroke is the one source where an
   out-of-range value is a typo. */
"logging.session.set.rpe.hint" = "Optional, 1 to 10";
"logging.session.set.notes.label" = "Note";
"logging.session.set.notes.hint" = "Optional";
"logging.session.set.confirm.action" = "Log set";
"logging.session.set.cancel.action" = "Cancel";
/* Accessibility labels: all four controls draw a glyph and have no visible title (G-4.2). */
"logging.session.set.weight.increase" = "Increase weight";
"logging.session.set.weight.decrease" = "Decrease weight";
"logging.session.set.reps.increase" = "Add a rep";
"logging.session.set.reps.decrease" = "Remove a rep";
/* Why the confirming command is refusing. Beside the command rather than under a field, so it is
   in the same place whichever field is wrong. */
"logging.session.set.invalid.message" = "Enter a weight and reps. RPE, if given, is 1 to 10.";
/* The unit a load is entered in (G-3.1). Written again here rather than shared with Settings: two
   surfaces, two strings, and a suffix on a number field is not a picker of units. */
"logging.session.set.unit.kilograms" = "kg";
"logging.session.set.unit.pounds" = "lb";
/* VoiceOver's label for the bare numeral a set row leads with. */
"logging.session.set.position %lld" = "Set %lld";
/* VoiceOver's label for the numeral after the multiplication sign, which is decorative and hidden.
   A label beside a number rather than a plural, for the same reason "Sets" above is one. */
"logging.session.set.reps %lld" = "Reps %lld";
/* A logged set's rating. The number arrives already rendered, so it is the locale's. */
"logging.session.set.rpe %@" = "RPE %@";

/* FR-16.1.1's set groups: consecutive identical sets read as one line. */
/* The badge a group leads with — the numbers of its first and last set. Both arrive already
   rendered, so a range is drawn in the same style as the bare numeral on the row beside it, and the
   separator is punctuation this catalogue owns rather than a dash written in Swift. */
"logging.session.set.number-range %@ %@" = "%1$@–%2$@";
/* VoiceOver's label for that badge. Never "1–4": read aloud, a dash is not a word. */
"logging.session.set.position-range %lld %lld" = "Sets %1$lld to %2$lld";
/* The same for a warmup group's badge. */
"logging.session.set.warmup.position-range %lld %lld" = "Warmup sets %1$lld to %2$lld";
/* What a tap on a collapsed group does (FR-16.1.3). The rows it opens carry every per-set control,
   so the hint promises the sets themselves rather than "more". */
"logging.session.set.group.hint" = "Shows each set";

/* FR-1.2.4 and FR-1.2.14: warmups, marked and numbered apart from the work. */
/* The badge a warmup row leads with. "W1" rather than "1" is the requirement's own spelling, and it
   is a string rather than a "W" glued to a numeral so a language that prefixes differently — or
   does not use a Latin W — can say it its own way. The number arrives already rendered, so it is
   the locale's — and the same style the working badge beside it is drawn with. */
"logging.session.set.warmup.number %@" = "W%@";
/* VoiceOver's label for that badge. Never "W1": read aloud, that is three letters and a digit. */
"logging.session.set.warmup.position %lld" = "Warmup %lld";
/* The badge is also the control that changes a set's kind (FR-1.2.4), so it carries a hint saying
   what a tap does. Two strings rather than one with a state in it: a hint names the action about to
   happen, and "Mark as warmup" on a set that already is one is the opposite instruction. */
"logging.session.set.mark-warmup" = "Mark as warmup";
"logging.session.set.mark-working" = "Mark as working";
/* FR-1.6.3's and FR-16.2.4's badge, and what VoiceOver reads in its place. Short on the row
   because the line is already spending its width on the load and two 44pt controls; the label
   carries the whole claim. Two spellings of one badge, chosen on the set count rather than on how
   many cells the set holds: the one-set column is a rep max and a lifter writes it "8RM", every
   other cell is a scheme and they write it "5×5". Neither spelling needs a plural rule — the
   numeral sits inside the compound in both. */
"logging.session.set.record.scheme %lld %lld" = "PR %1$lld×%2$lld";
"logging.session.set.record.rep-max %lld" = "PR %lldRM";
"logging.session.set.record.scheme.label %lld %lld" = "Personal record, %1$lld by %2$lld";
"logging.session.set.record.rep-max.label %lld" = "Personal record, %lld-rep max";
/* FR-1.2.14's collapsible group. A label beside a numeral, so it stays a count in every language
   rather than needing a plural rule. */
"logging.session.set.warmup.section" = "Warmups";
/* The set editor's fifth row: which kind the set being logged is. The sentence says what the choice
   costs rather than what the switch does — that warmups are excluded from the work is the fact a
   user needs before flipping it, and it is the same fact FR-1.6's calculator acts on. */
"logging.session.set.warmup.label" = "Warmup set";
"logging.session.set.warmup.hint" = "Numbered separately, and left out of your working sets.";

/* FR-1.2.5: whether a set was completed or failed. */
/* VoiceOver's label for the outcome control at the end of a set row, and the word its glyph stands
   for. "Failed" is the set's own outcome and not a verdict on the lifter: it means not all the
   planned reps were achieved, self-reported, nothing having prescribed them (OUT-1.1). */
"logging.session.set.outcome.completed" = "Completed";
"logging.session.set.outcome.failed" = "Failed";
/* What tapping that control does, as its hint. Two strings rather than one with a state in it, for
   the reason the warmup pair above is two: a hint names the action about to happen, and the row
   below a failed one carries the opposite instruction. */
"logging.session.set.mark-failed" = "Mark as failed";
"logging.session.set.mark-completed" = "Mark as completed";

/* FR-1.2.7: editing a set that is already logged, and deleting one. */
/* The editor's title when it is open over an existing set rather than collecting a new one. The
   form is the same five fields either way — what changes is this, the confirming command, and a
   deletion offered only where there is something to delete. */
"logging.session.set.editor.edit-title" = "Edit set";
/* The confirming command in that mode. "Save changes" rather than "Save set": the set is already
   saved, and what the button writes is the difference. */
"logging.session.set.save.action" = "Save changes";
/* VoiceOver's hint on a set row's values, which are the way into the editor. The action, not the
   state, like the two marking hints above. */
"logging.session.set.edit.action" = "Edit set";
/* The editor's destructive command, and the label on the dialogue's own confirming button. */
"logging.session.set.delete.action" = "Delete set";
/* The confirmation. Deleting is soft (G-1.3) but nothing in the app can undo one, so what the
   message names is the consequence the user cannot see: the set leaves the history AND the numbers
   derived from it. */
"logging.session.set.delete.confirm.title" = "Delete this set?";
"logging.session.set.delete.confirm.message" = "It leaves your history and stops counting towards your records.";
"logging.session.set.delete.confirm.action" = "Delete set";
/* The way out names what it keeps, like the discard dialogue's does: a bare "Cancel" beside a
   destructive command reads as cancelling the set rather than the deletion.
   PRESENTATION-DEPENDENT, AND KEPT ON PURPOSE, for the same reason Keep workout is. iOS 26 renders
   this dialogue as a popover, and a popover suppresses the `.cancel` button — only Delete set is
   drawn, and dismissing is a tap outside. The button stays: the suppression is that presentation's
   and not universal, and the `.cancel` role is what binds keyboard dismissal and gives VoiceOver an
   explicit way out that tap-outside does not (G-4.2, NFR-1.10). A string nothing currently draws
   still resolves, so no test can tell you this — which is why it is written down here. */
"logging.session.set.delete.confirm.cancel" = "Keep set";

/* FR-1.2.8: the modifiers a set was performed under, and the configurable list they come from. */
/* The editor's sixth row. Plural, because a set can carry several: the row is a multi-select and a
   singular label would read as a choice of one. */
"logging.session.set.modifier.label" = "Modifiers";
"logging.session.set.modifier.hint" = "Optional";
/* What the row's control says when none are applied. A word rather than an empty control: a blank
   button reads as one that has not loaded. */
"logging.session.set.modifier.none" = "None";
"logging.session.set.modifier.picker.title" = "Modifiers";
/* The way out of the picker. "Done" rather than "Save": nothing is written until the set itself is,
   and a button promising a save would be promising the wrong one. */
"logging.session.set.modifier.done.action" = "Done";
"logging.session.set.modifier.manage.action" = "Manage list";
"logging.session.set.modifier.manage.title" = "Manage modifiers";
/* The one consequence a user cannot see: the vocabulary and the logged set are separate, so editing
   the list never rewrites history (G-1.6). Said here because the alternative is a user renaming a
   term and expecting last month's sets to follow. */
"logging.session.set.modifier.manage.hint" = "Renaming or removing a modifier leaves sets you have already logged exactly as they are.";
"logging.session.set.modifier.built-in.section" = "Built in";
"logging.session.set.modifier.custom.section" = "Your modifiers";
"logging.session.set.modifier.custom.empty" = "Add your own — chains, bands, anything you want to record.";
"logging.session.set.modifier.add.label" = "New modifier";
"logging.session.set.modifier.add.action" = "Add";
/* Why a typed term was not added. Both refusals in one sentence rather than two strings: the field
   is one line and the user can see which of the two it was. */
"logging.session.set.modifier.add.refusal" = "Type a name that is not already on the list.";
"logging.session.set.modifier.remove.action" = "Remove";
/* A term a set carries that the list no longer offers — one written by a newer version, or one the
   user removed. Shown beside it rather than hiding the row: the set keeps the modifier either way,
   and a picker that omitted it would drop it on the next confirm (OpenVocabulary). */
"logging.session.set.modifier.unlisted" = "Not on your list";
/* VoiceOver's value on a modifier's row in the picker, which is a selection and not a command. */
"logging.session.set.modifier.applied" = "Applied";
"logging.session.set.modifier.not-applied" = "Not applied";
/* The nine built-in terms (FR-1.2.8). The key is written out per case rather than built from
   SetModifierTerm's raw value, that value being the wire format. "Touch and go" is the lifter's
   term for reps taken without resetting; "Board" is a board press, the range shortened by a board on
   the chest. */
"logging.session.set.modifier.belt" = "Belt";
"logging.session.set.modifier.sleeves" = "Sleeves";
"logging.session.set.modifier.wraps" = "Wraps";
"logging.session.set.modifier.straps" = "Straps";
"logging.session.set.modifier.paused" = "Paused";
"logging.session.set.modifier.tempo" = "Tempo";
"logging.session.set.modifier.touch-and-go" = "Touch and go";
"logging.session.set.modifier.deficit" = "Deficit";
"logging.session.set.modifier.board" = "Board";

/* FR-1.4.1 and FR-1.4.4 — the plate calculator, reached from the set editor's weight field. One
   label for the row and the screen: the row is the screen's summary and the screen is the row
   expanded, so two spellings would be two names for one thing. */
"logging.session.plate.row.label" = "Plate loading";
/* Drawn before the equipment has been read and after a read that failed. It names the tap rather
   than the wait — the tap resolves both, where "loading" would go on saying so over a read that is
   never coming back. */
"logging.session.plate.row.unknown" = "Tap to check your equipment";
/* A weight that will not go on the bar. The two nearest weights are the screen's job (FR-1.4.4);
   this row is one line inside a sheet already at NFR-1.10's ceiling. */
"logging.session.plate.row.not-loadable" = "Not exactly loadable";
"logging.session.plate.title" = "Plate loading";
"logging.session.plate.done.action" = "Done";
"logging.session.plate.target.label" = "Target";
"logging.session.plate.exact.section" = "Loads exactly";
"logging.session.plate.below.section" = "Nearest below";
"logging.session.plate.above.section" = "Nearest above";
/* FR-1.13.3, and the two halves say different things because the remedies are nothing alike: one is
   a target lighter than the equipment can go, the other is a gym without heavy enough plates. */
"logging.session.plate.below.none.headline" = "Nothing loads below";
"logging.session.plate.below.none.message" = "The bar and its collars already weigh more than this target.";
"logging.session.plate.above.none.headline" = "Nothing loads above";
"logging.session.plate.above.none.message" = "This gym's plates do not reach that weight. Add heavier pairs to the equipment profile.";
/* A loading that carries no plates — an answer, not a blank. */
"logging.session.plate.bare-bar" = "Bar and collars only";
"logging.session.plate.per-side.label" = "Per side";
"logging.session.plate.equipment.section" = "Equipment";
/* A gym the user set up and left unnamed. Theirs either way — only the name is missing. */
"logging.session.plate.equipment.unnamed" = "Unnamed gym";

/* FR-1.4.3 from the calculator: the way to the gym the numbers were worked out on. */
"logging.session.plate.change-equipment.action" = "Change gym";
/* FR-1.13.1's empty state, and it is an empty state rather than an error: the read succeeded and
   the user simply has no gym yet — either none has been set up or the one in use was deleted. The
   message covers both, because the tap out of them is the same one. */
"logging.session.plate.no-equipment.headline" = "No gym set up";
"logging.session.plate.no-equipment.message" = "Add a bar, its collars and the plates you have, and every loading is worked out from them.";
"logging.session.plate.no-equipment.action" = "Set up a gym";
"logging.session.plate.equipment.bar %@ %@" = "Bar %1$@, collars %2$@ each";
/* One denomination on one side. The multiplication sign is a character here rather than a drawn
   glyph, so VoiceOver reads it as a word. */
"logging.session.plate.count %@ %@" = "%1$@ × %2$@";
"logging.session.plate.error.headline" = "Equipment could not be read";
"logging.session.plate.error.message" = "Your bar and plates could not be loaded, so there is nothing to work the loading out from.";
"logging.session.plate.unusable.headline" = "This equipment cannot be used";
"logging.session.plate.unusable.message" = "Its plate list does not describe a gym. Edit the equipment profile to put it right.";

/* FR-1.4.2, FR-1.4.3 and FR-1.10.3 — equipment profiles, reached from the plate calculator and from
   Settings. One subject, two screens: the list of gyms and the form over one of them. */
"logging.equipment.title" = "Equipment";
"logging.equipment.empty.headline" = "No gym set up yet";
"logging.equipment.empty.message" = "Set up the bar, collars and plates you train with, and the app can work out what to load.";
"logging.equipment.add.action" = "Add a gym";
/* The gym every loading is worked out against. "In use" rather than "default": there is one, the
   user chose it, and nothing here falls back to it. */
"logging.equipment.active.badge" = "In use";
"logging.equipment.use.action" = "Use this gym";
/* Deleting the gym in use promotes nothing — which gym a lifter trains at next is not derivable, and
   a silently promoted one would compute every loading on a different bar without saying so. So the
   fact is stated instead, on the screen that can act on it. */
"logging.equipment.none-active" = "No gym is in use. Pick one and every loading is worked out from it.";
"logging.equipment.edit.action" = "Edit";
"logging.equipment.error.headline" = "Equipment could not be read";
"logging.equipment.error.message" = "Your gyms could not be loaded. Nothing has been lost — try again.";
"logging.equipment.write-error.title" = "That change was not saved";

"logging.equipment.create.title" = "Add a gym";
"logging.equipment.edit.title" = "Edit gym";
"logging.equipment.name.label" = "Name";
"logging.equipment.name.hint" = "Your own word for the place — home, the commercial gym, the meet. Optional.";
"logging.equipment.bar.label" = "Bar weight";
/* TR-0.3.7: the stored column is the mass of ONE collar, and a number entered as the pair doubles
   every loading the app produces. The label says which, rather than a placeholder that can go
   unread. */
"logging.equipment.collar.label" = "Weight of one collar";
