<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- FR-16.1.1's set count on a history row, read after the second multiplication sign — which
	     is decorative and hidden, as the first one is. A run of one draws no count at all, so the
	     singular is unreachable in English; it is spelled anyway, because a plural entry with a
	     wrong "one" is a trap for whichever language reaches it. -->
	<key>exerciselibrary.detail.history.sets %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@sets@</string>
		<key>sets</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld set</string>
			<key>other</key>
			<string>%lld sets</string>
		</dict>
	</dict>
	<!-- FR-1.6.2's record rows, headed by the N they stand at. The 1-rep row is the top of the
	     list and the first thing read on the screen, so "1 rep" rather than "1 reps" (FR-17.2.3,
	     G-3.4). -->
	<key>exerciselibrary.detail.records.reps %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@reps@</string>
		<key>reps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld rep</string>
			<key>other</key>
			<string>%lld reps</string>
		</dict>
	</dict>
</dict>
</plist>
