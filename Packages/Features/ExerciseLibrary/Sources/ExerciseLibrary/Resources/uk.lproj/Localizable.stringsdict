<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ukrainian takes four plural categories where English takes two: one (1, 21, 31…), few
	     (2–4, 22–24…), many (0, 5–20, 25–30…) and other, which a whole number never reaches. The
	     count stands alone here rather than after a preposition, so the noun takes the nominative
	     plural at «few» and the genitive at «many». -->
	<key>exerciselibrary.detail.history.sets %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@sets@</string>
		<key>sets</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld підхід</string>
			<key>few</key>
			<string>%lld підходи</string>
			<key>many</key>
			<string>%lld підходів</string>
			<key>other</key>
			<string>%lld підходу</string>
		</dict>
	</dict>
</dict>
</plist>
