/* DesignSystem (G-3.4). Keys are <module>.<screen>.<element>[.<role>] — see the Localization
   module doc. The "screen" segment names the state component rather than a screen: these five are
   the one part of this module that is shown on every screen and belongs to none of them.

   ONLY COPY THAT IS THE SAME EVERYWHERE LIVES HERE. A headline naming what a particular list is
   missing is the screen's and arrives as a Text the caller built — see DesignSystemStrings. */

"designsystem.error-state.headline" = "Something went wrong";
"designsystem.error-state.retry" = "Try again";

/* A spinner carries no text, so this is the whole of what VoiceOver has to announce (G-4.2). */
"designsystem.loading-state.accessibility-label" = "Loading";

/* G-2.1: every action still works offline, so this state is about a surface with nothing local to
   show — never about a blocked action. The second sentence is the part that must survive editing:
   without it the state reads as "your training log is gone". */
"designsystem.offline-state.headline" = "You're offline";
"designsystem.offline-state.message" = "This needs a connection. Everything you have logged is on this device and still works.";

"designsystem.insufficient-data.headline" = "Not enough data yet";
